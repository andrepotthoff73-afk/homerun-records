# Datenbank – wird automatisch von Vercel gesetzt, wenn du Neon unter "Storage" verbindest
DATABASE_URL=postgres://...

# Admin-Zugang (mind. 10 Zeichen) und ein langer Zufallswert für die Login-Sitzungen
ADMIN_PASSWORD=
SESSION_SECRET=

# PayPal (developer.paypal.com -> Apps & Credentials). Erst "sandbox" testen, dann "live".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Versand in Euro je Paket (max. 8 Platten pro Paket), optional versandkostenfrei ab Betrag (0 = aus)
SHIPPING_EUR=6.19
SHIPPING_PER_PACKAGE=8
FREE_SHIPPING_FROM=0

# Optional: Discogs-Token für automatische Cover-Bilder (discogs.com/settings/developers)
DISCOGS_TOKEN=
